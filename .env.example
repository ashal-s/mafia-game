# Supabase (server and browser clients)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only key used by automatic phase processing. Never expose this value
# through a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Vercel Cron sends this value as `Authorization: Bearer <CRON_SECRET>`.
# Generate a long random value and configure the same variable in Vercel.
CRON_SECRET=replace-with-a-long-random-secret

# Optional Web Push configuration.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@example.com
